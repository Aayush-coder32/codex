{
  "name": "skillbridge-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the SkillBridge academia-industry collaboration portal",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:check": "node scripts/db-check.js",
    "db:setup": "npm run db:migrate && npm run seed",
    "seed": "node scripts/seed.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-reporter=spec"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.23.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
